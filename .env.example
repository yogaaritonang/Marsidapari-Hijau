# Supabase project URL and public browser key. Never put service-role keys here.
VITE_SUPABASE_URL="https://project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="supabase-publishable-or-anon-key"

# Server-only Supabase credentials used for leader registration.
SUPABASE_URL="https://project-id.supabase.co"
SUPABASE_ANON_KEY="supabase-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
LEADER_SIGNUP_TOKEN="random-long-invitation-secret"
LEADER_AUTH_REDIRECT_URL="http://localhost:3000/pemimpin"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Dapatkan dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model Gemini terbaru dengan kapabilitas multimodal foto & teks
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: URL tempat aplikasi dihosting (Cloud Run atau Vercel)
APP_URL="MY_APP_URL"
